# Host path of the NAS share, already mounted on the Pi (see README, "NAS mount").
NAS_PATH=/mnt/nas/steuer

# Run the containers as this user so files on the NAS get sensible ownership (run `id` on the Pi).
PUID=1000
PGID=1000

STEUER_PORT=8080
TZ=Europe/Berlin

# Tax year shown by default (the year switcher in the UI covers the rest).
STEUER_YEAR=2026

# Optional HTTP basic auth. Leave empty on a trusted LAN; set both when anything else can reach the Pi.
STEUER_USER=
STEUER_PASSWORD=

STEUER_MAX_UPLOAD_MB=25
STEUER_OCR_LANG=deu+eng
# Documents read with less confidence than this go to the review queue.
STEUER_CONFIDENCE=0.7
STEUER_POLL_SECONDS=30
# Daily DB backup to <NAS>/_backups after this hour; number of copies to keep.
STEUER_BACKUP_HOUR=3
STEUER_BACKUP_KEEP=14
